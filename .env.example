# LLM Provider Configuration
# We use Vertex AI by default, but fallback can be configured here.
GOOGLE_APPLICATION_CREDENTIALS=path/to/key.json

# If using another provider instead (e.g. OpenAI):
# OPENAI_API_KEY=your_key_here

# Alternatively, configure Gemini API directly (takes precedence if Vertex is not used):
# GEMINI_API_KEY=your_gemini_key_here
